<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Anime Fanart Gallery</title>

<style>
body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#111;
    color:white;
}

header{
    background:#6a00ff;
    text-align:center;
    padding:30px;
}

header h1{
    margin:0;
}

.gallery{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
    padding:30px;
}

.card{
    background:#222;
    border-radius:10px;
    overflow:hidden;
    transition:.3s;
}

.card:hover{
    transform:scale(1.05);
}

.card img{
    width:100%;
    height:350px;
    object-fit:cover;
}

.card h3{
    padding:10px;
    text-align:center;
}

footer{
    text-align:center;
    padding:20px;
    background:#000;
}
</style>
</head>

<body>

<header>
    <h1>Anime Fanart Gallery</h1>
    <p>Sharing my favorite anime-inspired artwork</p>
</header>

<section class="gallery">

    <div class="card">
        images/art1.jpg
        <h3>Fanart #1</h3>
    </div>

    <div class="card">
        images/art2.jpg
        <h3>Fanart #2</h3>
    </div>

    <div class="card">
        images/art3.jpg
        <h3>Fanart #3</h3>
    </div>

</section>

<footer>
    © 2026 Anime Fanart Gallery
</footer>

</body>
</html>
