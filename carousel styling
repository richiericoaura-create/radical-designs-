.hero {
    height:100vh;
    position:relative;
    overflow:hidden;
}

.slide {
    position:absolute;
    width:100%;
    height:100%;
    opacity:0;
    transition:opacity 1.5s ease;
}

.slide.active {
    opacity:1;
}

.slide img {
    width:100%;
    height:100%;
    object-fit:cover;
    filter:
        brightness(0.55)
        saturate(1.2);
}

.overlay {
    position:absolute;
    top:50%;
    left:50%;
    transform:translate(-50%,-50%);
    text-align:center;
    color:white;
}

.overlay h1 {
    font-size:4rem;
    text-shadow:0 0 25px rgba(120,180,255,.8);
}

.overlay p {
    font-size:1.3rem;
}
